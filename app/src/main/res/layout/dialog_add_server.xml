<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <EditText android:id="@+id/et_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/hint_name"
        android:layout_marginBottom="12dp" />
    <EditText android:id="@+id/et_url" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/hint_server_url"
        android:inputType="textUri" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/appBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout android:id="@+id/container"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="GitHub: @weleone" android:textColor="?attr/appFooterText" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="个人学习研究使用，请勿用于商业用途&#10;视频版权归原作者所有，下载内容请在24小时内删除"
                android:textColor="?attr/appFooterText" android:textSize="11sp"
                android:gravity="center" />
            <TextView android:id="@+id/tv_version"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="v1.0.0" android:textColor="?attr/appFooterText" android:textSize="11sp" />
        </LinearLayout>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
    <ImageButton android:id="@+id/btn_theme"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp" android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_theme"
        app:tint="?attr/appTextSecondary"
        android:contentDescription="切换风格" />
</FrameLayout>

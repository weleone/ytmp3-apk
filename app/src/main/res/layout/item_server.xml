<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp"
    android:gravity="center_vertical"
    android:background="?attr/appSurface" android:layout_marginBottom="8dp">
    <RadioButton android:id="@+id/rb_select"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:buttonTint="#1F9D55" android:layout_marginEnd="4dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="?attr/appTextPrimary" android:textSize="16sp" />
        <TextView android:id="@+id/tv_url" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="?attr/appTextSecondary" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/tv_drag"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="&#x2261;" android:textSize="22sp" android:textColor="?attr/appTextSecondary"
        android:paddingStart="8dp" android:paddingEnd="8dp" />
    <Button android:id="@+id/btn_del"
        android:backgroundTint="?attr/appButtonTintRed" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/delete" android:textSize="12sp" />
</LinearLayout>

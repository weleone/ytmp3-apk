<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/appBackground" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/title_servers" android:textSize="20sp" android:textColor="?attr/appTextPrimary"
        android:layout_marginBottom="16dp" />
    <Button android:id="@+id/btn_add"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/add_server" android:backgroundTint="?attr/appButtonTintPurple"
        android:layout_marginBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_servers"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
